{
  "name": "github-readme-stats",
  "version": "1.0.0",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "main": "src/index.js",
  "type": "module",
  "homepage": "https://github.com/anuraghazra/github-readme-stats",
  "bugs": {
    "url": "https://github.com/anuraghazra/github-readme-stats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anuraghazra/github-readme-stats.git"
  },
  "scripts": {
    "dev": "wrangler pages dev public",
    "sync:home": "node --experimental-strip-types scripts/sync-home.ts",
    "build": "npm run sync:home && tsc --noEmit && wrangler pages functions build",
    "deploy": "wrangler pages deploy public",
    "start": "wrangler pages dev public",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:jest && npm run test:hono",
    "test:hono": "node --experimental-strip-types tests/hono.test.ts",
    "test:jest": "node --experimental-strip-types --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:update:snapshot": "node --experimental-strip-types --experimental-vm-modules node_modules/jest/bin/jest.js -u",
    "test:e2e": "node --experimental-strip-types --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js",
    "theme-readme-gen": "node scripts/generate-theme-doc",
    "preview-theme": "node scripts/preview-theme",
    "close-stale-theme-prs": "node scripts/close-stale-theme-prs",
    "generate-langs-json": "node scripts/generate-langs-json",
    "readme:snippet": "node scripts/print-readme.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings src scripts tests api themes functions",
    "bench": "node --experimental-strip-types --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.bench.config.js"
  },
  "author": "Anurag Hazra",
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^6.0.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.6.6",
    "@uppercod/css-to-object": "^1.1.1",
    "axios-mock-adapter": "^2.1.0",
    "color-contrast-checker": "^2.1.0",
    "dotenv": "^18.0.9",
    "hjson": "^3.2.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "lodash.snakecase": "^4.1.1",
    "oxlint": "^1.64.0",
    "parse-diff": "^0.11.1",
    "prettier": "^3.7.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "axios": "^1.13.1",
    "emoji-name-map": "^2.0.3",
    "github-username-regex": "^1.0.0",
    "hono": "^4.13.16",
    "word-wrap": "^1.2.5",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  }
}
