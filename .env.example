# =============================================================================
# GitHub Readme Stats - self-host configuration
# Copy this file to .env, then fill in the values.
# Never commit a .env file that contains a token.
# =============================================================================

# Required: classic PAT with `repo` + `read:user` scopes.
# Remove the # after filling in the token.
# PAT_1=ghp_xxxxxxxxxxxxxxxx

# Required on Vercel: only this username may use the instance.
# Separate multiple usernames with commas. Leave empty for local use only.
WHITELIST=machfudn

# Default username when the ?username= parameter is omitted.
GITHUB_USERNAME=machfudn

# Public Vercel deployment URL, without a trailing slash.
# Update this after the Vercel project has been created.
SITE_URL=https://github-readme-stats-machfudn.vercel.app

# Card cache in seconds. 21600 = 6 hours.
CACHE_SECONDS=21600

# Fetch all repository pages when counting stars (self-hosted instances only).
FETCH_MULTI_PAGE_STARS=true

# Repositories to exclude (name only, without the owner).
EXCLUDE_REPO=

# README snippet generator options (optional).
README_THEME=transparent
README_LOCALE=en
README_INCLUDE_ALL_COMMITS=true
README_LANGS_COUNT=8
