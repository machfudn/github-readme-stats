# =============================================================================
# GitHub Readme Stats - konfigurasi self-host
# Salin file ini menjadi .env, lalu isi nilainya.
# Jangan pernah commit file .env yang berisi token.
# =============================================================================

# Wajib: classic PAT dengan scope `repo` + `read:user`.
PAT_1=

# Wajib di Vercel: hanya username ini yang boleh memakai instance.
# Pisahkan dengan koma jika lebih dari satu. Kosongkan hanya untuk lokal.
WHITELIST=machfudn

# Username default saat parameter ?username= tidak diberikan.
GITHUB_USERNAME=machfudn

# URL publik deployment Vercel, tanpa slash di akhir.
# Ganti nilainya setelah project Vercel selesai dibuat.
SITE_URL=https://github-readme-stats-machfudn.vercel.app

# Cache kartu dalam detik. 21600 = 6 jam.
CACHE_SECONDS=21600

# Ambil semua halaman repo saat menghitung stars (khusus instance sendiri).
FETCH_MULTI_PAGE_STARS=true

# Repo yang tidak ingin dihitung (nama saja, tanpa owner).
EXCLUDE_REPO=

# Opsi generator snippet README (opsional).
README_THEME=transparent
README_LOCALE=id
README_INCLUDE_ALL_COMMITS=true
README_LANGS_COUNT=8
